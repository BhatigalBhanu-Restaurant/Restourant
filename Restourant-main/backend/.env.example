# ============================================================
# Bhatigal Bhanu Restaurant ERP - Environment Configuration
# ============================================================
# Copy this file to backend/.env and fill in your values

# Server
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/restaurant_erp
DB_NAME=restaurant_erp

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=royal_heritage_restaurant_jwt_secure_super_secret_key_2026
JWT_REFRESH_SECRET=royal_heritage_restaurant_jwt_refresh_secure_secret_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=production
DEBUG=false

# ============================================================
# GOOGLE CALENDAR INTEGRATION (Optional)
# Follow the setup guide in backend/app/services/google_calendar_service.py
# ============================================================

# Step 1: Download service account JSON from Google Cloud Console
# Step 2: Save it as backend/google_service_account.json
# Step 3: Share your Google Calendar with the service account email
# Step 4: Copy the Calendar ID from Google Calendar Settings and paste below

# Your Google Calendar ID (e.g., yourname@gmail.com or abc123@group.calendar.google.com)
GOOGLE_CALENDAR_ID=

# ============================================================
# CORS (Add your production domain when deploying)
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000
